{
  "manifest_version": 3,
  "name": "Lazy AI - Pro",
  "version": "1.0",
  "description": "Instant AI overlay with history and pin mode.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open Lazy AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-ai": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Lazy AI"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}